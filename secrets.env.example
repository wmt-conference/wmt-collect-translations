# Copy this file to `secrets.env` (untracked) and fill in the keys you need.
# Leave any key you don't use empty; empty keys are ignored.

# Cohere key
COHERE_API_KEY=
# Together API key
TOGETHER_API_KEY=
# OpenAI / Azure key
OPENAI_API_KEY=
# Anthropic key for Claude
ANTHROPIC_API_KEY=
# Mistral API key
MISTRAL_API_KEY=
# Gemini API key for Google AI Studio
GEMINI_API_KEY=
# DeepL credentials
DEEPL_PRO_AUTH_KEY=
# Google Cloud Translate credentials
GOOGLE_API_KEY=
# Yandex API key
YANDEX_API_KEY=
# Yandex folder id
YANDEX_FOLDER_ID=
# Microsoft Azure API key
MTAPI_SUBSCRIPTION_KEY=
# Microsoft Azure region (default: eastus)
MTAPI_REGION=
